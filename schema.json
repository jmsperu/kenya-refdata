    "payment_service_providers": {"key": ["category", "name"], "required": ["category", "name"]},
    "money_remittance_providers": {"key": ["category", "name"], "required": ["category", "name"]},
    "credit_reference_bureaus": {"key": ["category", "name"], "required": ["category", "name"]},
    "digital_credit_providers": {"key": ["category", "name"], "required": ["category", "name"]},
    "forex_bureaus": {"key": ["category", "name"], "required": ["category", "name"]},
    "saccos": {"key": ["category", "name"], "required": ["category", "name"]},
    "insurers": {"key": ["category", "name"], "required": ["category", "name"]},
    "insurance_brokers": {"key": ["category", "name"], "required": ["category", "name"]},
    "cma_licensees": {"key": ["category", "name"], "required": ["category", "name"]},
    "court_stations": {"key": ["category", "name"], "required": ["category", "name"]},
    "auctioneers": {"key": ["category", "name"], "required": ["category", "name"]},
    "statutory_bodies": {"key": ["category", "name"], "required": ["category", "name"]},
    "msisdn_prefixes": {"key": ["prefix"], "required": ["prefix", "operator"]},
    "public_holidays": {"key": ["date"], "required": ["date", "name", "kind"]},
    "currencies": {"key": ["code"], "required": ["code", "name"]},
    "education_levels": {"key": ["code"], "required": ["code", "name"]},
